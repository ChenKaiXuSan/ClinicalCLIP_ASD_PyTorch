<mxfile host="app.diagrams.net">
  <diagram id="clinical-concept" name="Clinical Concept Grounding">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 分区背景 -->
        <mxCell id="bgTrain" value="训练期" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;fontSize=15;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="1440" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="bgInfer" value="推理期 —— 只输入视频,医生标注不参与" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#66bb6a;dashed=1;verticalAlign=top;align=left;fontSize=15;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="1060" width="1440" height="340" as="geometry" />
        </mxCell>

        <!-- 输入 -->
        <mxCell id="nVideo" value="视频 (B, 3, 8, 224, 224)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="90" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="nDoctor" value="医生标注(仅训练期)&#10;doctor1.csv / doctor2.csv&#10;两位医生各自的关注区域" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1020" y="80" width="380" height="80" as="geometry" />
        </mxCell>

        <!-- backbone -->
        <mxCell id="nBackbone" value="ResNet3D slow_r50 (Kinetics 预训练)&#10;→ tokens Z (B, 256, 8, 7, 7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="210" width="340" height="70" as="geometry" />
        </mxCell>

        <!-- 概念库 -->
        <mxCell id="nBank" value="临床概念库 P (R=5, 256)&#10;foot / wrist / shoulder /&#10;lumbar_pelvis / head&#10;&#10;可学习,或加载冻结的文本向量&#10;(prompt: &quot;the clinician focuses on …&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="500" y="185" width="330" height="120" as="geometry" />
        </mxCell>

        <!-- 交叉注意力 -->
        <mxCell id="nCross" value="概念条件交叉注意力&#10;Q = P,  K/V = Z&#10;A_r = softmax over (T&#39;,H&#39;,W&#39;) of ⟨P_r, Z⟩·s&#10;F_r = Σ A_r · V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="370" width="420" height="100" as="geometry" />
        </mxCell>

        <mxCell id="nAttn" value="概念注意力 A&#10;(B, 5, 8, 7, 7)&#10;已归一化为时空分布" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="700" y="530" width="250" height="80" as="geometry" />
        </mxCell>

        <mxCell id="nFeat" value="区域特征 F&#10;(B, 5, 256)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="270" y="530" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- presence head -->
        <mxCell id="nPresence" value="presence head → π (B, 5)&#10;预测&quot;医生会关注哪些区域&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="240" y="660" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- 聚合与分类 -->
        <mxCell id="nPool" value="加权聚合 v = Σ σ(π_r)·F_r / Σσ(π_r)&#10;⊕ 全局池化 mean(Z)&#10;先验只作引导,不做唯一通路" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="790" width="400" height="90" as="geometry" />
        </mxCell>

        <mxCell id="nCls" value="classifier → logits (B, 3)&#10;ASD / DHS / LCS_HipOA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="920" width="320" height="70" as="geometry" />
        </mxCell>

        <!-- 监督目标 -->
        <mxCell id="nSoft" value="区域软标签 q (B, 5)&#10;q_r = 选择该区域的医生占比&#10;两人一致=1.0  只有一人=0.5&#10;(不取并集:两医生仅 45.7% 一致,&#10;分歧本身是信息)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1050" y="220" width="330" height="120" as="geometry" />
        </mxCell>

        <mxCell id="nRegionMap" value="按区域渲染的高斯图 M&#10;(B, 5, 8, 28, 28)&#10;区域→COCO 关键点→骨架坐标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1050" y="400" width="330" height="90" as="geometry" />
        </mxCell>

        <!-- 四项损失 -->
        <mxCell id="lCls" value="L_cls  交叉熵" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="530" y="930" width="230" height="50" as="geometry" />
        </mxCell>

        <mxCell id="lPres" value="L_presence  软目标 BCE(π, q)&#10;让模型学会&quot;该看哪&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="620" y="660" width="330" height="70" as="geometry" />
        </mxCell>

        <mxCell id="lGround" value="L_grounding  Σ_r q_r · KL(A_r ‖ M_r)&#10;把模型注意力对齐到医生区域图&#10;q_r=0 的区域不施加空间约束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="530" width="390" height="90" as="geometry" />
        </mxCell>

        <mxCell id="lConcept" value="L_concept  F_r 与概念库 P 的对比损失&#10;负例是另外 4 个概念,不是批内样本&#10;→ 消除假负例,防止概念塌缩" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="560" y="790" width="390" height="90" as="geometry" />
        </mxCell>

        <!-- 推理期 -->
        <mxCell id="iVideo" value="视频" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="90" y="1180" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="iModel" value="ClinicalConceptNet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="1180" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="iOut1" value="疾病预测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="640" y="1120" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="iOut2" value="预测的关注区域 π&#10;→ 与留出医生标注对分: region_f1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="640" y="1190" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="iOut3" value="时空注意力 A&#10;→ 与医生区域图的软 IoU: attn_iou" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="640" y="1275" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="iNote" value="可解释性从&quot;把医生的图画进模型&quot;变成&#10;&quot;模型自己预测的关注点与医生一致&quot;——&#10;后者是可评估、可发表的主张,&#10;且部署时不需要医生先标注" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#66bb6a;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1040" y="1160" width="380" height="120" as="geometry" />
        </mxCell>

        <!-- 连线 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="nVideo" target="nBackbone"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="Z" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="nBackbone" target="nCross"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="P" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="nBank" target="nCross"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="nCross" target="nFeat"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="nCross" target="nAttn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="nFeat" target="nPresence"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="nFeat" target="nPool"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="σ(π) 加权" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="nPresence" target="nPool"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="mean(Z) 残差通路" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="nBackbone" target="nPool"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="nPool" target="nCls"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="nCls" target="lCls"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="nDoctor" target="nSoft"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="nSoft" target="nRegionMap"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="q" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="nSoft" target="lPres"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" value="π" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="nPresence" target="lPres"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" value="M" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="nRegionMap" target="lGround"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" value="A" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="nAttn" target="lGround"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="nFeat" target="lConcept"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e19" value="P" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="nBank" target="lConcept"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="iVideo" target="iModel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="iModel" target="iOut1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="iModel" target="iOut2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="iModel" target="iOut3"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
